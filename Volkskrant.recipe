        #        return COVER_URL % m.group(1)
        #    self.log.warn('No issue id found at %s (ended up at %s)' % (TITLE_URL, final))
        #    self.log.warn('Page starts with: %r' % body[:300])
        #except Exception:
        #    self.log.exception('Could not determine cover')
        #return None
        self.log('Cover: using fixed cover URL %s' % COVER_URL)
