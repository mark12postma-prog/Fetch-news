#!/usr/bin/env python
import copy
import io
import re
from contextlib import closing
from urllib.parse import parse_qs, quote, unquote, urljoin, urlsplit

from lxml import etree
from lxml import html as lxml_html
from PIL import Image, ImageEnhance

from calibre.web.feeds.recipes import BasicNewsRecipe

BASE = 'https://www.volkskrant.nl'
INDEX_PATH = '/krant/digitaal/vandaag/'
GATE_HOST = 'myprivacy.dpgmedia.nl'
# Front page of the latest issue: the title page redirects to .../titles/volkskrant/<id>
TITLE_URL = 'https://krant.volkskrant.nl/titles/volkskrant'
# COVER_URL = 'https://digitalekrant.volkskrant.nl/volkskrant/teasers/%s/medium.jpg'
COVER_URL = 'https://digitalekrant.volkskrant.nl/volkskrant/teasers/7929/medium.jpg'
_ISSUE_ID_RE = re.compile(r'/titles/volkskrant/(\d+)')

# Volkskrant article URLs look like /<section>/<slug>~b1a2b3c4d/
_ARTICLE_PATH_RE = re.compile(r'^(?:/[^/?#]+)+~b[0-9a-f]{6,12}/?$')
_ARTICLE_SCAN_RE = re.compile(r'(?:https?://(?:www\.)?volkskrant\.nl)?(/(?:[\w\-]+/)+[\w\-]+~b[0-9a-f]{6,12}/?)')

# Page furniture, matched against class / id / data-testid (strict pass only)
_JUNK_CLS = re.compile(
    r'(?<![a-z])(share|social|newsletter|signup|promo|related|recommend|lees-?ook|read-?more|'
    r'advert|adslot|ad-slot|banner|footer|comment|toolbar|util|breadcrumb|podcast|player|'
    r'sidebar|cookie|consent|popup|modal|byline|author|dateline|keyword|topics?|most-?read|'
    r'sponsor|login|teaser)', re.I)
_INTRO_CLS = re.compile(r'(?<![a-z])(intro|subtitle|standfirst|lead|abstract|summary|subhead)(?![a-z])', re.I)
_DROP_TAGS = {'script', 'noscript', 'style', 'svg', 'button', 'form', 'iframe', 'nav', 'footer',
              'aside', 'audio', 'video', 'template', 'dialog', 'select', 'input'}

_SKIP_BLOCK_RE = re.compile(r'^(lees ook|lees meer|zie ook|kijk ook)\b', re.I)
_STOP_HEAD_RE = re.compile(r'^(reacties|gerelateerd|meer van|meest gelezen|aanbevolen|ook interessant|lees ook)\b', re.I)
_BYLINE_RE = re.compile(r'^(door|tekst|gepubliceerd|bijgewerkt|verslaggever)\b', re.I)
_PAYWALL_RE = re.compile(r'(word abonnee|lees verder met|inloggen|log in|bekijk onze abonnementen|'
                         r'voorbehouden aan abonnees|alleen voor abonnees)', re.I)
_CREDIT_RE = re.compile(r'^(.*)\b(Beeld|Foto|Fotografie|Illustratie)\s+([^.]{2,60})$', re.S)
_INLINE_KEEP = {'em', 'strong', 'i', 'b', 'br', 'sup', 'sub'}


def _squash(text):
    return ' '.join((text or '').split())


def _article_url(href):
    '''Absolute article URL for an href, or None when it is not a Volkskrant article.'''
    if not href:
        return None
    parts = urlsplit(urljoin(BASE + '/', href.strip()))
    if parts.netloc not in ('www.volkskrant.nl', 'volkskrant.nl'):
        return None
    if not _ARTICLE_PATH_RE.match(parts.path):
        return None
    return BASE + parts.path.rstrip('/') + '/'


def _slug_title(url):
    slug = urlsplit(url).path.rstrip('/').rsplit('/', 1)[-1].split('~')[0]
    return slug.replace('-', ' ').capitalize()


class Volkskrant(BasicNewsRecipe):
    title = 'de Volkskrant'
    __author__ = 'Modelled on the NRC recipe'
    description = 'de Volkskrant - de krant van vandaag, in de volgorde van de papieren krant'
    language = 'nl'
    country = 'NL'
    category = 'news, politics, Netherlands'
    encoding = 'utf-8'
    max_articles_per_feed = 100
    resolve_internal_links = True
    ignore_duplicate_articles = {'url'}
    delay = 0.3
    touchscreen = True

    # Images: handled in preprocess_image() below, so calibre's own
    # scaling/compression is off (otherwise images are processed twice).
    no_stylesheets = True
    compress_news_images = False
    scale_news_images_to_device = False
    scale_news_images = None

    screen_size = (1264, 1680)  # Kobo Libra Colour, portrait (px)
    base_quality = 90           # quality of the scaled reference JPEG
    extra_compression = 4       # x times smaller than that reference
    min_quality = 35            # floor: no image gets worse than this
    max_image_width = 1600      # biggest srcset candidate we bother to download

    # The article is rebuilt from scratch in preprocess_raw_html(), so no
    # auto_cleanup / keep_only_tags / remove_tags are needed.
    auto_cleanup = False

    # Headings on the index page that are not part of the printed paper.
    skip_sections = ('meest gelezen', 'meest gedeeld', 'aanbevolen', 'nieuwsbrief',
                     'abonneer', 'ook interessant')

    extra_css = '''
        h1, h2 { hyphens: none; text-align: left; page-break-after: avoid; }
        h1 { font-size: 1.44em; line-height: 1.15; margin: 0.4em 0 0.5em 0; }
        h2 { font-size: 1.2em; line-height: 1.2; margin: 1.4em 0 0.4em 0; }
        p { margin: 0; text-indent: 1.2em; text-align: justify;
            hyphens: auto; orphans: 2; widows: 2; }
        h1 + p, h2 + p, p.vk-caption + p, p.vk-credit + p { text-indent: 0; }
        p.vk-label { text-indent: 0; text-align: left; color: #444;
                     font-variant: small-caps; letter-spacing: 0.08em;
                     hyphens: none; }
        p.vk-intro { text-indent: 0; text-align: left; font-style: italic;
                     font-size: 1.1em; line-height: 1.3;
                     margin: 0.2em 0 0.8em 0; padding-bottom: 0.6em;
                     border-bottom: 0.5pt solid #888; }
        p.vk-img { text-indent: 0; text-align: center; margin-top: 0.8em;
                   page-break-inside: avoid; page-break-after: avoid; }
        img { max-width: 100%; }
        p.vk-caption, p.vk-credit { text-indent: 0; text-align: right;
                   font-size: 0.83em; font-style: italic; color: #444;
                   hyphens: none; }
        p.vk-credit { margin-bottom: 0.8em; }
        blockquote { margin: 0.8em 1.5em; font-style: italic; }
        blockquote p { text-indent: 0; }
    '''

    _index_html = ''

    # ------------------------------------------------------------------
    # Index: today's paper, in printed order
    # ------------------------------------------------------------------

    @staticmethod
    def _is_gate(url):
        return urlsplit(url).netloc == GATE_HOST

    @staticmethod
    def _original_url(url):
        '''The article URL behind a privacy-gate URL (or the URL itself).'''
        if urlsplit(url).netloc != GATE_HOST:
            return url
        try:
            callback = parse_qs(urlsplit(url).query)['callbackUrl'][0]
            path = parse_qs(urlsplit(callback).query)['redirectUri'][0]
            return urljoin(BASE + '/', unquote(path))
        except Exception:
            return url

    def _fetch_page(self, url, br=None):
        '''GET a page. When DPG's privacy gate (myprivacy.dpgmedia.nl) intercepts,
        follow its callback URL, which is what pressing "Akkoord" does. That sets
        the consent cookie on volkskrant.nl, after which the page loads normally.'''
        br = br or self.browser
        url = self._original_url(url)
        with closing(br.open(url)) as r:
            final = r.geturl()
            data = r.read().decode('utf-8', 'replace')
        if not self._is_gate(final):
            return data
        callback = (parse_qs(urlsplit(final).query).get('callbackUrl') or [None])[0]
        if not callback:
            path = urlsplit(url).path
            callback = BASE + '/privacygate-confirm?redirectUri=' + quote(path, safe='').replace('~', '%7E')
        self.log('Privacy gate hit, confirming via %s' % callback)
        with closing(br.open(callback)) as r:
            r.read()
        with closing(br.open(url)) as r:
            final = r.geturl()
            data = r.read().decode('utf-8', 'replace')
        if self._is_gate(final):
            self.log.warn('Still on the privacy gate after confirming: %s' % final)
        return data

    @staticmethod
    def _parse(raw):
        try:
            return lxml_html.fromstring(raw)
        except ValueError:  # unicode string with an encoding declaration
            try:
                return lxml_html.fromstring(raw.encode('utf-8'))
            except Exception:
                return None
        except Exception:
            return None

    def _section_name(self, el):
        '''Text of a heading if it is a section heading, else None.'''
        for anc in el.iterancestors():
            if anc.tag in ('article', 'nav', 'footer'):
                return None  # teaser kicker, menu, footer
            if anc.tag == 'a' and _article_url(anc.get('href')):
                return None  # headline inside an article link
        for a in el.iter('a'):
            if _article_url(a.get('href')):
                return None  # headline wrapping an article link
        name = _squash(el.text_content())
        if not name or len(name) > 40:
            return None
        return name

    @staticmethod
    def _anchor_title(a, url):
        '''(title, from_slug) for an article link.'''
        for h in a.xpath('.//h1|.//h2|.//h3|.//h4|.//h5'):
            t = _squash(h.text_content())
            if t:
                return t, False
        for anc in a.iterancestors():
            if anc.tag in ('h1', 'h2', 'h3', 'h4', 'h5'):
                t = _squash(anc.text_content())
                if t:
                    return t, False
                break
        t = _squash(a.get('aria-label') or a.get('title') or '') or _squash(a.text_content())
        if t:
            if len(t) > 140:
                t = t[:137].rsplit(' ', 1)[0] + '…'
            return t, False
        return _slug_title(url), True

    def _parse_sections(self, raw):
        root = self._parse(raw)
        if root is None:
            return []
        sections = []    # [(name, [article, ...])] in page order
        named = {}       # name -> article list
        by_url = {}      # url -> article dict
        slug_titled = set()
        current = None   # article list we are adding to
        skipping = False
        for el in root.iter():
            tag = el.tag
            if not isinstance(tag, str):
                continue
            if tag in ('h2', 'h3', 'h4'):
                name = self._section_name(el)
                if not name:
                    continue
                skipping = any(s in name.lower() for s in self.skip_sections)
                if not skipping:
                    if name not in named:
                        named[name] = []
                        sections.append((name, named[name]))
                    current = named[name]
            elif tag == 'a':
                url = _article_url(el.get('href'))
                if not url or skipping:
                    continue
                if any(a.tag in ('nav', 'footer') for a in el.iterancestors()):
                    continue
                title, from_slug = self._anchor_title(el, url)
                if url in by_url:
                    if url in slug_titled and not from_slug:
                        by_url[url]['title'] = title
                        slug_titled.discard(url)
                    continue
                if current is None:
                    named['Volkskrant'] = current = []
                    sections.append(('Volkskrant', current))
                art = dict(title=title, url=url)
                by_url[url] = art
                current.append(art)
                if from_slug:
                    slug_titled.add(url)
        return [(name, arts) for name, arts in sections if arts]

    def _scan_for_urls(self, raw):
        '''Last resort: any article URL anywhere in the page source (e.g. inside JSON).'''
        text = raw.replace('\\/', '/').replace('\\u002F', '/')
        articles, seen = [], set()
        for m in _ARTICLE_SCAN_RE.finditer(text):
            url = _article_url(m.group(1))
            if url and url not in seen:
                seen.add(url)
                articles.append(dict(title=_slug_title(url), url=url))
        return [('Volkskrant', articles)] if articles else []

    def parse_index(self):
        html = ''
        try:
            html = self._fetch_page(BASE + INDEX_PATH)
        except Exception:
            self.log.exception('Could not open %s' % (BASE + INDEX_PATH))
        sections = self._parse_sections(html)
        if not sections:
            self.log.warn('No article links with section headings found')
        self._index_html = html
        if not sections and html:
            self.log.warn('Falling back to scanning the page source for article URLs')
            sections = self._scan_for_urls(html)
        if not sections:
            self.log.error('No articles found. Page starts with: %r' % html[:300])
            return []
        total = sum(len(a) for _, a in sections)
        self.log('Found %d articles in %d sections' % (total, len(sections)))
        for name, arts in sections:
            self.log('  %s: %d' % (name, len(arts)))
        # Get the consent cookie now, so the parallel article downloads don't all
        # hit the privacy gate at once.
        try:
            self._fetch_page(sections[0][1][0]['url'])
        except Exception:
            self.log.exception('Could not warm up the privacy-gate consent')
        return sections

