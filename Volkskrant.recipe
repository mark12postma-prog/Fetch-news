    # ------------------------------------------------------------------
    # Articles: rebuild a clean page from the article markup
    # ------------------------------------------------------------------

    def _image_url(self, node, img, page_url):
        '''Best usable image URL for an <img> (or <picture>/<figure> around it).'''
        cands = []   # (width, url)
        sources = [img] + (list(node.iter('source')) if node is not img else [])
        for el in sources:
            for attr in ('srcset', 'data-srcset'):
                for u, w in re.findall(r'(\S+)\s+(\d+)w', el.get(attr) or ''):
                    cands.append((int(w), u))
        plain = img.get('src') or img.get('data-src') or ''
        url = plain
        if cands:
            small = [c for c in cands if c[0] <= self.max_image_width]
            # biggest candidate within the limit, else the smallest one available
            url = max(small)[1] if small else min(cands)[1]
        if not url or url.startswith('data:'):
            url = plain
        if not url or url.startswith('data:') or url.lower().split('?')[0].endswith('.svg'):
            return None
        for dim in ('width', 'height'):
            v = (img.get(dim) or '').strip()
            if v.isdigit() and int(v) < 60:
                return None  # icon / avatar
        return urljoin(page_url, url)

    @staticmethod
    def _inline(tag, node):
        '''Copy of node as a clean <tag> that keeps only basic inline markup.'''
        node = copy.deepcopy(node)
        etree.strip_elements(node, etree.Comment, 'script', 'style', 'noscript', 'svg',
                             'button', 'figure', with_tail=False)
        drop = {d.tag for d in node.iter() if d is not node and isinstance(d.tag, str)
                and d.tag not in _INLINE_KEEP}
        if drop:
            etree.strip_tags(node, *drop)
        new = lxml_html.Element(tag)
        new.text = node.text
        for child in list(node):
            new.append(child)
        for d in new.iter():
            d.attrib.clear()
        return new

    def _is_junk(self, el, strict):
        if el.tag in _DROP_TAGS:
            return True
        if strict:
            ident = ' '.join(filter(None, (el.get('class'), el.get('id'), el.get('data-testid'))))
            if ident and _JUNK_CLS.search(ident):
                return True
        return False

    def _build_article(self, article, page_url, strict):
        body = lxml_html.Element('div')
        st = dict(title=False, label=False, intro=False, stop=False, paras=0,
                  paywall=False, imgs=set())

        def add(tag, text=None, cls=None):
            el = lxml_html.Element(tag)
            if text is not None:
                el.text = text
            if cls:
                el.set('class', cls)
            body.append(el)
            return el

        def caption(text):
            m = _CREDIT_RE.match(text)
            if m:
                cap, cred = m.group(1).strip(), '%s %s' % (m.group(2), m.group(3).strip())
                if cap:
                    add('p', cap, 'vk-caption')
                add('p', cred, 'vk-credit')
            else:
                add('p', text, 'vk-caption')

        def image(node):
            img = node if node.tag == 'img' else next(node.iter('img'), None)
            if img is None:
                return
            src = self._image_url(node, img, page_url)
            if not src or src in st['imgs']:
                return
            st['imgs'].add(src)
            p = add('p', None, 'vk-img')
            etree.SubElement(p, 'img').set('src', src)
            if node.tag == 'figure':
                cap = node.find('.//figcaption')
                if cap is not None and _squash(cap.text_content()):
                    caption(_squash(cap.text_content()))

        def header_block(tag, text):
            if len(text) < 80 and _BYLINE_RE.match(text):
                return
            if not st['intro'] and len(text) > 25:
                add('p', text, 'vk-intro')
                st['intro'] = True
            elif not st['intro'] and not st['label']:
                add('p', text, 'vk-label')
                st['label'] = True

        def walk(node, in_header):
            for child in node:
                if st['stop']:
                    return
                tag = child.tag
                if not isinstance(tag, str) or self._is_junk(child, strict):
                    continue
                if tag == 'header':
                    walk(child, True)
                elif tag == 'h1':
                    if not st['title']:
                        body.append(self._inline('h1', child))
                        st['title'] = True
                elif tag in ('figure', 'picture', 'img'):
                    image(child)
                elif tag in ('p', 'h2', 'h3', 'h4'):
                    text = _squash(child.text_content())
                    if not text:
                        continue
                    if tag != 'p' and _STOP_HEAD_RE.match(text):
                        st['stop'] = True
                    elif in_header and tag in ('p', 'h2', 'h3'):
                        header_block(tag, text)
                    elif _SKIP_BLOCK_RE.match(text):
                        continue
                    elif tag == 'p' and len(text) < 200 and _PAYWALL_RE.search(text):
                        st['paywall'] = True
                    elif (not st['intro'] and tag in ('p', 'h2', 'h3') and st['title']
                          and _INTRO_CLS.search(child.get('class') or '') and len(text) > 25):
                        add('p', text, 'vk-intro')
                        st['intro'] = True
                    elif tag == 'p':
                        body.append(self._inline('p', child))
                        st['paras'] += 1
                    else:
                        body.append(self._inline('h2', child))
                elif tag == 'blockquote':
                    text = _squash(child.text_content())
                    if text:
                        etree.SubElement(add('blockquote'), 'p').text = text
                elif tag in ('ul', 'ol') and not in_header:
                    items = [_squash(li.text_content()) for li in child.findall('li')]
                    items = [i for i in items if i]
                    if items:
                        lst = add(tag)
                        for i in items:
                            etree.SubElement(lst, 'li').text = i
                else:
                    walk(child, in_header)

        walk(article, False)
        return body, st

    def preprocess_raw_html(self, raw_html, url):
        out = self._render(raw_html, url)
        if out is None:
            # Probably the privacy gate instead of the article: confirm and refetch.
            self.log.warn('No article text in %s, retrying via the privacy gate' % url)
            try:
                raw2 = self._fetch_page(url, self.clone_browser(self.browser))
                out = self._render(raw2, url)
            except Exception:
                self.log.exception('Refetch failed for %s' % url)
        if out is None:
            self.log.warn('Giving up on %s' % url)
            return ('<html><head><meta charset="utf-8"/><title>Volkskrant</title></head><body>'
                    '<p>Artikel kon niet worden opgehaald: %s</p></body></html>' % self._original_url(url))
        return out

    def _render(self, raw_html, url):
        '''Clean article page for raw_html, or None when it holds no article text.'''
        root = self._parse(raw_html)
        if root is None:
            return None
        articles = root.xpath('//article')
        if articles:
            best, best_len = None, -1
            for a in articles:   # the real article is the one with the most paragraph text
                n = len(''.join(a.xpath('.//p//text()')))
                if n >= best_len:
                    best, best_len = a, n
            article = best
        else:
            article = (root.xpath('//main') or root.xpath('//body') or [root])[0]

        body = st = None
        for strict in (True, False):
            body, st = self._build_article(article, url, strict)
            if st['paras'] >= 3:
                break
            if strict:
                self.log.warn('Little text found in %s, retrying without class filters' % url)
        if st['paras'] < 1:
            return None
        if st['paywall']:
            self.log.warn('Paywall text in %s: article is probably truncated' % url)
        if not st['title']:
            h1 = root.find('.//h1')
            if h1 is not None:
                body.insert(0, self._inline('h1', h1))

        title = _squash(body.findtext('h1') or '') or 'Volkskrant'
        doc = lxml_html.fromstring(
            '<html><head><meta charset="utf-8"/><title></title></head><body></body></html>')
        doc.find('.//title').text = title
        doc.find('.//body').append(body)
        return lxml_html.tostring(doc, encoding='unicode')

    # ------------------------------------------------------------------
    # Images: scale to the screen, then compress a further factor
    # ------------------------------------------------------------------

    @staticmethod
    def _jpeg(img, quality):
        buf = io.BytesIO()
        img.save(buf, 'JPEG', quality=quality, optimize=True)
        return buf.getvalue()

    def preprocess_image(self, img_data, image_url):
        try:
            img = Image.open(io.BytesIO(img_data))
            if img.mode in ('RGBA', 'LA') or (
                    img.mode == 'P' and 'transparency' in img.info):
                img = img.convert('RGBA')
                bg = Image.new('RGB', img.size, (255, 255, 255))
                bg.paste(img, mask=img.getchannel('A'))
                img = bg
            elif img.mode not in ('RGB', 'L'):
                img = img.convert('RGB')

            # 1. Scale down to the screen (never up)
            img.thumbnail(self.screen_size, Image.LANCZOS)
            if img.mode == 'RGB':
                img = ImageEnhance.Color(img).enhance(1.15)
                img = ImageEnhance.Contrast(img).enhance(1.05)

            # 2. Reference size, then find the highest quality that is
            #    extra_compression times smaller than it
            target = len(self._jpeg(img, self.base_quality)) / self.extra_compression
            lo, hi, best = self.min_quality, self.base_quality, None
            while lo <= hi:
                mid = (lo + hi) // 2
                data = self._jpeg(img, mid)
                if len(data) <= target:
                    best, lo = data, mid + 1
                else:
                    hi = mid - 1
            return best or self._jpeg(img, self.min_quality)
        except Exception:
            self.log.exception('Could not process image %s' % image_url)
            return img_data


calibre_most_common_ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36'
