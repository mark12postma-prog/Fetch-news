#!/usr/bin/env python
# vim:fileencoding=utf-8
from calibre.web.feeds.news import BasicNewsRecipe


class LeeuwarderCourant(BasicNewsRecipe):
    title = 'Leeuwarder Courant'
    __author__ = 'user'
    description = 'Nieuws uit Friesland (lc.nl)'
    language = 'nl'
    publisher = 'Mediahuis Noord'
    category = 'nieuws, Friesland, Leeuwarden'

    # Only articles from the last day = "today's" paper
    oldest_article = 1
    max_articles_per_feed = 60
    use_embedded_content = False
    no_stylesheets = True
    remove_javascript = True
    auto_cleanup = True
    compress_news_images = True
    ignore_duplicate_articles = {'title', 'url'}

    feeds = [
        ('Leeuwarder Courant', 'https://www.lc.nl/api/feed/rss'),
    ]
