#!/usr/bin/env python
import datetime
import json
import re
from contextlib import closing

from lxml import html as lxml_html
from mechanize import Request

from calibre.web.feeds.recipes import BasicNewsRecipe


def _cls(name):
    '''XPath test for an exact class token ("x" must not match "x-positioned").'''
    return 'contains(concat(" ", normalize-space(@class), " "), " %s ")' % name


def _keep_div(name):
    '''XPath for a div with this class, plus everything inside it.'''
    return '//div[%s]/descendant-or-self::*' % _cls(name)


_KEYWORD_RE = re.compile(r'<span class="keyword">([^<]+)</span>\s*')


class NRC(BasicNewsRecipe):
    title = 'NRC'
    __author__ = 'Cristi Ghera'
    description = 'NRC - Nieuws, achtergronden en onderzoeksjournalistiek'
    language = 'nl'
    country = 'NL'
    category = 'news, politics, Netherlands'
    encoding = 'utf-8'
    max_articles_per_feed = 100
    resolve_internal_links = True
    ignore_duplicate_articles = {'url'}
    delay = 0.3
    touchscreen = True

    # Images
    no_stylesheets = True
    compress_news_images = True
    compress_news_images_auto_size = 24

    # The article header (title, intro, first image) is not a sibling of the
    # text block, and every part of it has "header" in its class name, which
    # auto_cleanup treats as page furniture. preprocess_raw_html() moves the
    # header into the text block; auto_cleanup_keep then protects the parts
    # we want. The byline and the share bar are left out on purpose.
    auto_cleanup = True
    auto_cleanup_keep = '|'.join([
        '//header[%s]' % _cls('vorm__article-header'),
        _keep_div('dmt-header__headline'),   # title
        _keep_div('dmt-header__abstract'),   # section label + intro
        _keep_div('dmt-header__image'),      # first image + caption
    ])

    # Safety net: runs after auto_cleanup
    remove_tags = [
        dict(
            attrs={
                'class': [
                    'vorm__article-footer',
                    'dmt-header__util-bar',
                    'dmt-header__byline',
                    'dmt-signup',
                    'dmt-preferred-source',
                ]
            }
        ),
        dict(name=['script', 'noscript', 'style', 'dmt-util-bar']),
    ]
    remove_attributes = ['class', 'id', 'name', 'style']

    frontpage = None

    @staticmethod
    def _monthly_list_url(date, fmt='%Y/%m/'):
        return 'https://www.nrc.nl/de/data/NH/' + date.strftime(fmt)

    @staticmethod
    def _clean_article_title(title):
        if not title:
            return title
        return _KEYWORD_RE.sub(r'\1 ', title)

    def parse_index(self):
        sections = []
        today = datetime.date.today()
        headers = {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json, text/javascript, */*; q=0.01',
            'DNT': '1',
        }
        monthly_list_urls = [
            self._monthly_list_url(today),
            self._monthly_list_url(datetime.date(today.year, today.month, 1) - datetime.timedelta(days=1)),
        ]
        issue_url = None
        for monthly_list_url in monthly_list_urls:
            with closing(self.browser.open(Request(monthly_list_url, None, headers))) as r:
                issues = json.loads(r.read())
                if len(issues) > 0:
                    issue_date = datetime.datetime.strptime(issues[0]['published_at'], '%Y-%m-%dT%H:%M:%SZ')
                    issue_url = self._monthly_list_url(issue_date, '%Y/%m/%d/')
                    self.frontpage = issues[0]['frontpage']
                    break
        if issue_url is None:
            return []
        with closing(self.browser.open(Request(issue_url, None, headers))) as r:
            edition = json.loads(r.read())
        documents = {}
        for headline in edition['paperheadlines']:
            item = headline['item']
            documents[headline['document_id']] = dict(
                url=item['full_url'],
                headline=self._clean_article_title(item['headline']),
            )
        for section in edition['sections']:
            articles = []
            for doc in section['document_ids']:
                if doc not in documents:
                    self.log.warn('Document not found:', doc)
                    continue
                articles.append(dict(title=documents[doc]['headline'], url=documents[doc]['url']))
            sections.append((section['name'], articles))
        return sections

    def preprocess_raw_html(self, raw_html, url):
        # Move the article header into the article text block, so that
        # auto_cleanup sees it as part of the article.
        try:
            root = lxml_html.fromstring(raw_html)
            header = root.xpath('//article//header[%s]' % _cls('vorm__article-header'))
            content = root.xpath('//div[%s]' % _cls('vorm__article-content'))
            if header and content:
                content[0].insert(0, header[0])
                return lxml_html.tostring(root, encoding='unicode')
        except Exception:
            self.log.exception('Could not move the article header for %s' % url)
        return raw_html

    def preprocess_html(self, soup):
        for img in soup.findAll('img'):
            src = img.get('data-src-medium') or img.get('data-src')
            if src:
                img['src'] = src.split('|')[0]
            src = img.get('src', '')
            if src.startswith('//'):
                img['src'] = 'https:' + src
            elif src.startswith('/'):
                img['src'] = 'https://www.nrc.nl' + src
        if self.browser.cookiejar:
            self.browser.cookiejar.clear()
        return soup

    def get_cover_url(self):
        return self.frontpage


calibre_most_common_ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36'
