#!/usr/bin/env python
# vim:fileencoding=utf-8
# Daily-paper layout of de Volkskrant ("De krant van vandaag"), built the same
# way as calibre's NRC recipe: sections and article order follow the printed
# edition. Based on the calibre 'volksrant' recipe by Cristi Ghera.
import json
import uuid
from contextlib import closing

from mechanize import Request

from calibre.web.feeds.recipes import BasicNewsRecipe


class Volkskrant(BasicNewsRecipe):
    title = 'de Volkskrant'
    __author__ = 'Based on calibre recipe by Cristi Ghera'
    description = 'de Volkskrant - de krant van vandaag, in de volgorde van de papieren editie'
    language = 'nl'
    country = 'NL'
    category = 'news, politics, Netherlands'
    needs_subscription = False
    max_articles_per_feed = 100
    resolve_internal_links = True
    encoding = 'utf-8'
    no_stylesheets = True
    ignore_duplicate_articles = {'url'}
    delay = 0.3

    remove_tags_before = dict(id='main-content')
    remove_tags_after = dict(id='main-content')
    remove_tags = [
        dict(
            attrs={
                'class': [
                    'article-footer__sharing',
                    'artstyle__editorial-tips',
                    'artstyle__advertisement',
                    'artstyle__container__icon',
                    'artstyle__disabled-embed',
                    'container__title__icon',
                ]
            }
        ),
        dict(attrs={'data-element-id': ['article-element-authors']}),
        dict(name=['script', 'noscript', 'style']),
    ]
    remove_attributes = ['class', 'id', 'name', 'style']

    SITE = 'https://www.volkskrant.nl'
    # The privacy-wall URL accepts the cookie wall and redirects to today's edition
    EDITION_URL = SITE + '/privacy-wall/accept?redirectUri=%2Feditie%2Fvandaag%2F&authId='
    FOLDERS_URL = 'https://login-api.e-pages.dk/v1/krant.volkskrant.nl/folders'

    def _span_text(self, parent, heading, css_class):
        h = parent.find(heading) if parent is not None else None
        span = h.find('span', attrs={'class': css_class}) if h is not None else None
        return self.tag_to_string(span).strip() if span is not None else ''

    def _article_title(self, a):
        header = a.find('header')
        label = self._span_text(header, 'h4', 'teaser__label')
        sublabel = self._span_text(header, 'h4', 'teaser__sublabel')
        title = self._span_text(header, 'h3', 'teaser__title__value--short')
        if label.lower() == 'podcast':
            return None
        parts = []
        if label:
            parts.append(label.upper())
        if sublabel:
            parts.append(sublabel)
        if title:
            parts.append(title)
        if not parts:
            return self.tag_to_string(a).strip() or None
        return ' \u2022 '.join(parts)

    def parse_index(self):
        soup = self.index_to_soup(self.EDITION_URL + str(uuid.uuid4()))
        sections = []
        for container in soup.find_all('section', attrs={'class': 'section--horizontal'}):
            h2 = container.find('h2')
            section_title = self.tag_to_string(h2).strip() if h2 is not None else ''
            articles = []
            for art in container.find_all('article'):
                a = art.find('a', href=True)
                if a is None:
                    continue
                url = a['href']
                if url.startswith('/'):
                    url = self.SITE + url
                if '/editie/' not in url:
                    continue
                title = self._article_title(a)
                if not title:
                    continue
                articles.append(dict(title=title, url=url))
            if articles:
                sections.append((section_title or 'Overig', articles))
            else:
                self.log.warn('Section without articles skipped:', section_title)
        return sections

    def preprocess_html(self, soup):
        for tag in soup.find_all('picture'):
            img = tag.find('img')
            if img is not None:
                tag.replace_with(img)
        for tag in soup.find_all('img'):
            src = tag.get('src')
            if src and src.startswith('//'):
                tag['src'] = 'https:' + src
            elif src and src.startswith('/'):
                tag['src'] = self.SITE + src
        # Comic strips: keep only the first figure, drop text after it
        comic_articles = {'Bas van der Schot', 'Poldermodellen', 'Gummbah', 'Sigmund'}
        h1 = soup.find('h1')
        if h1 is not None and self.tag_to_string(h1).strip() in comic_articles:
            figure = soup.find('figure')
            if figure is not None:
                for node in figure.find_next_siblings():
                    node.extract()
        return soup

    def get_cover_url(self):
        headers = {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json, text/javascript, */*; q=0.01',
            'DNT': '1',
        }
        try:
            with closing(self.browser.open(Request(self.FOLDERS_URL, None, headers))) as r:
                folders = json.loads(r.read())
            return folders['objects'][0]['teaser_medium']
        except Exception as e:
            self.log.warn('Could not get cover:', e)
        return None
