#!/usr/bin/env python
import datetime
import json
import re
import io
from PIL import Image, ImageEnhance
from contextlib import closing

from lxml import html as lxml_html
from mechanize import Request

from calibre.web.feeds.recipes import BasicNewsRecipe


def _cls(name):
    '''XPath test for an exact class token ("x" must not match "x-positioned").'''
    return 'contains(concat(" ", normalize-space(@class), " "), " %s ")' % name


def _keep_div(name):
    '''XPath for a div with this class, plus everything inside it.'''
    return '//div[%s]/descendant-or-self::*' % _cls(name)


_KEYWORD_RE = re.compile(r'<span class="keyword">([^<]+)</span>\s*')
_CREDIT_RE = re.compile(r"foto(?:’s|'s|s)?\b", re.I)


class NRC(BasicNewsRecipe):
    title = 'NRC'
    __author__ = 'Cristi Ghera'
    description = 'NRC - Nieuws, achtergronden en onderzoeksjournalistiek'
    language = 'nl'
    country = 'NL'
    category = 'news, politics, Netherlands'
    encoding = 'utf-8'
    max_articles_per_feed = 100
    resolve_internal_links = True
    ignore_duplicate_articles = {'url'}
    delay = 0.3
    touchscreen = True

    # Images
    # no_stylesheets = True
    # compress_news_images = True
    # compress_news_images_auto_size = 16

    # Images: handled in preprocess_image() below, so calibre's own
    # scaling/compression is off (otherwise images are processed twice).
    no_stylesheets = True
    compress_news_images = False
    scale_news_images_to_device = False
    scale_news_images = None

    screen_size = (1264, 1680)  # Kobo Libra Colour, portrait (px)
    base_quality = 90           # quality of the scaled reference JPEG
    extra_compression = 4       # x times smaller than that reference
    min_quality = 35            # floor: no image gets worse than this



    # The article header (title, intro, first image) is not a sibling of the
    # text block, and every part of it has "header" in its class name, which
    # auto_cleanup treats as page furniture. preprocess_raw_html() moves the
    # header into the text block; auto_cleanup_keep then protects the parts
    # we want. The byline and the share bar are left out on purpose.
    auto_cleanup = True
    auto_cleanup_keep = '|'.join([
        '//header[%s]' % _cls('vorm__article-header'),
        _keep_div('dmt-header__headline'),   # title
        _keep_div('dmt-header__abstract'),   # section label + intro
        _keep_div('dmt-header__image'),      # first image + caption
    ])

    # Safety net: runs after auto_cleanup
    remove_tags = [
        dict(
            attrs={
                'class': [
                    'vorm__article-footer',
                    'dmt-header__util-bar',
                    'dmt-header__byline',
                    'dmt-signup',
                    'dmt-preferred-source',
                ]
            }
        ),
        dict(name=['script', 'noscript', 'style', 'dmt-util-bar']),
    ]
    remove_attributes = ['class', 'id', 'name', 'style']

    extra_css = '''
        h1, h2 { hyphens: none; text-align: left; page-break-after: avoid; }
        h1 { font-size: 1.44em; line-height: 1.15; margin: 0.4em 0 0.5em 0; }
        h2 { font-size: 1.2em; line-height: 1.2; margin: 1.4em 0 0.4em 0; }
        p { margin: 0; text-indent: 1.2em; text-align: justify;
            hyphens: auto; orphans: 2; widows: 2; }
        h1 + p, h2 + p, p.nrc-caption + p, p.nrc-credit + p { text-indent: 0; }
        p.nrc-label { text-indent: 0; text-align: left; color: #444;
                      font-variant: small-caps; letter-spacing: 0.08em;
                      hyphens: none; }
        p.nrc-intro { text-indent: 0; text-align: left; font-style: italic;
                      font-size: 1.1em; line-height: 1.3;
                      margin: 0.2em 0 0.8em 0; padding-bottom: 0.6em;
                      border-bottom: 0.5pt solid #888; }
        p.nrc-img { text-indent: 0; text-align: center; margin-top: 0.8em;
                    page-break-inside: avoid; page-break-after: avoid; }
        img { max-width: 100%; }
        p.nrc-caption, p.nrc-credit { text-indent: 0; text-align: right;
                    font-size: 0.83em; font-style: italic; color: #444;
                    hyphens: none; }
        p.nrc-credit { margin-bottom: 0.8em; }
    '''



    frontpage = None

    @staticmethod
    def _monthly_list_url(date, fmt='%Y/%m/'):
        return 'https://www.nrc.nl/de/data/NH/' + date.strftime(fmt)

    @staticmethod
    def _clean_article_title(title):
        if not title:
            return title
        return _KEYWORD_RE.sub(r'\1 ', title)

    def parse_index(self):
        sections = []
        today = datetime.date.today()
        headers = {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json, text/javascript, */*; q=0.01',
            'DNT': '1',
        }
        monthly_list_urls = [
            self._monthly_list_url(today),
            self._monthly_list_url(datetime.date(today.year, today.month, 1) - datetime.timedelta(days=1)),
        ]
        issue_url = None
        for monthly_list_url in monthly_list_urls:
            with closing(self.browser.open(Request(monthly_list_url, None, headers))) as r:
                issues = json.loads(r.read())
                if len(issues) > 0:
                    issue_date = datetime.datetime.strptime(issues[0]['published_at'], '%Y-%m-%dT%H:%M:%SZ')
                    issue_url = self._monthly_list_url(issue_date, '%Y/%m/%d/')
                    # self.frontpage = issues[0]['frontpage']
                    self.frontpage = issues[0]['frontpage_images']['full']
                    break
        if issue_url is None:
            return []
        with closing(self.browser.open(Request(issue_url, None, headers))) as r:
            edition = json.loads(r.read())
        documents = {}
        for headline in edition['paperheadlines']:
            item = headline['item']
            documents[headline['document_id']] = dict(
                url=item['full_url'],
                headline=self._clean_article_title(item['headline']),
            )
        for section in edition['sections']:
            articles = []
            for doc in section['document_ids']:
                if doc not in documents:
                    self.log.warn('Document not found:', doc)
                    continue
                articles.append(dict(title=documents[doc]['headline'], url=documents[doc]['url']))
            sections.append((section['name'], articles))
        return sections

    def preprocess_raw_html(self, raw_html, url):
        # Move the article header into the article text block, so that
        # auto_cleanup sees it as part of the article.
        try:
            root = lxml_html.fromstring(raw_html)
            header = root.xpath('//article//header[%s]' % _cls('vorm__article-header'))
            content = root.xpath('//div[%s]' % _cls('vorm__article-content'))
            if header and content:
                content[0].insert(0, header[0])
                return lxml_html.tostring(root, encoding='unicode')
        except Exception:
            self.log.exception('Could not move the article header for %s' % url)
        return raw_html

    @staticmethod
    def _jpeg(img, quality):
        buf = io.BytesIO()
        img.save(buf, 'JPEG', quality=quality, optimize=True)
        return buf.getvalue()

    def preprocess_image(self, img_data, image_url):
        try:
            img = Image.open(io.BytesIO(img_data))
            if img.mode in ('RGBA', 'LA') or (
                    img.mode == 'P' and 'transparency' in img.info):
                img = img.convert('RGBA')
                bg = Image.new('RGB', img.size, (255, 255, 255))
                bg.paste(img, mask=img.getchannel('A'))
                img = bg
            elif img.mode not in ('RGB', 'L'):
                img = img.convert('RGB')

            # 1. Scale down to the screen (never up)
            img.thumbnail(self.screen_size, Image.LANCZOS)
            if img.mode == 'RGB':
                img = ImageEnhance.Color(img).enhance(1.15)
                img = ImageEnhance.Contrast(img).enhance(1.05)


            # 2. Reference size, then find the highest quality that is
            #    extra_compression times smaller than it
            target = len(self._jpeg(img, self.base_quality)) / self.extra_compression
            lo, hi, best = self.min_quality, self.base_quality, None
            while lo <= hi:
                mid = (lo + hi) // 2
                data = self._jpeg(img, mid)
                if len(data) <= target:
                    best, lo = data, mid + 1
                else:
                    hi = mid - 1
            return best or self._jpeg(img, self.min_quality)
        except Exception:
            self.log.exception('Could not process image %s' % image_url)
            return img_data


    def preprocess_html(self, soup):
        for img in soup.findAll('img'):
            src = img.get('data-src-medium') or img.get('data-src')
            if src:
                img['src'] = src.split('|')[0]
            src = img.get('src', '')
            if src.startswith('//'):
                img['src'] = 'https:' + src
            elif src.startswith('/'):
                img['src'] = 'https://www.nrc.nl' + src
        if self.browser.cookiejar:
            self.browser.cookiejar.clear()
        return soup

    def postprocess_html(self, soup, first_fetch):
        for p in soup.find_all('p'):
            if not p.get_text(strip=True) and not p.find('img'):
                p.decompose()

        h1 = soup.find('h1')
        if h1 is not None:
            ps = h1.find_all_next('p', limit=3)
            if len(ps) == 3:
                label, extra, intro = ps
                lt = label.get_text(' ', strip=True)
                if len(lt) <= 25 and extra.get_text(' ', strip=True).startswith(lt):
                    extra.decompose()
                    label['class'] = 'nrc-label'
                    intro['class'] = 'nrc-intro'

        for p in soup.find_all('p'):
            if not p.find('img'):
                continue
            p['class'] = 'nrc-img'
            cap = p.find_next('p')
            if cap is None or cap.find('img') or cap.get('class'):
                continue
            ct = cap.get_text(' ', strip=True)
            if len(ct) > 300:
                continue
            if _CREDIT_RE.match(ct):
                cap['class'] = 'nrc-credit'
                continue
            cap['class'] = 'nrc-caption'
            cred = cap.find_next('p')
            if cred is not None and len(cred.get_text(strip=True)) < 80 \
                    and _CREDIT_RE.match(cred.get_text(' ', strip=True)):
                cred['class'] = 'nrc-credit'
        return soup


    def get_cover_url(self):
        return self.frontpage


calibre_most_common_ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36'
